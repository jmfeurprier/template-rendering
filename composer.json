{
    "name": "jmf/template-rendering",
    "description" : "Simple wrapper around Twig to render templates",
    "license": "mit",
    "type": "library",
    "require": {
        "php": ">=8.3",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpmd/phpmd": "^2.13",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.0",
        "squizlabs/php_codesniffer": "^3.8"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Jmf\\TemplateRendering\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jmf\\TemplateRendering\\Tests\\": "tests/src"
        }
    }
}
